PORT=5000
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Phase 3 — RAG / Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
CHAT_HISTORY_LIMIT=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SUMMARY_CHUNK_BATCH_SIZE=6
SUMMARY_SHORT_WORD_LIMIT=150
SUMMARY_MEDIUM_WORD_LIMIT=350
SUMMARY_DETAILED_WORD_LIMIT=700
QUIZ_MAX_QUESTIONS=20
QUIZ_MIN_QUESTIONS=5
QUIZ_MAX_GENERATION_RETRIES=1
FLASHCARD_MAX_CARDS=20
FLASHCARD_MIN_CARDS=5
FLASHCARD_MAX_GENERATION_RETRIES=1
STUDY_MAX_QUESTIONS=20
STUDY_MIN_QUESTIONS=5
STUDY_MAX_EVAL_RETRIES=1
STUDY_CONTEXT_RECENT_QUESTIONS=3